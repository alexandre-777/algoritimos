programa {
  funcao inicio() {
    //declaração de variáveis
    inteiro senha

    //coleta de dados
    escreva("digite a sua senha:")
    leia(senha)

    //processamento de dados
     se(senha == 1234) {
      escreva("Sistema Liberado!")
     } senao{
      escreva("Senha incorreta - Invasor detectado.")
     }

    
  }
}
