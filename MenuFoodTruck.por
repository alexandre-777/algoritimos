programa {
  funcao inicio() {
    inteiro opcao
        escreva(" (1) Hambúrguer - R$ 25; (2) Batata Frita - R$ 15; (3) Refrigerante - R$ 8; escolha(1-3):")
        leia(opcao)

      

        escolha(opcao) {
            caso 1:
            escreva("(1) Hambúrguer - R$ 25")
            pare
            caso 2:
            escreva("(2) Batata Frita - R$ 15")
            pare
            caso 3:
            escreva("(3) Refrigerante - R$ 8")
            pare
            caso contrario:
            escreva("opção inválida!")
        }
  }
}
