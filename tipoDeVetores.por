programa {
  funcao inicio() {
    //sintaxe: tipo nome[tamnho]

    inteiro nota[5]
    real altura[10]
    cadeia nome[3]
    logico respostas[4]

    //atribuindo valores individuais
    nota[0] = 10
    nota[1] = 9
    nota[2] = 7
    nota[3] = 10
    nota[4] = 5

    altura[0] = 1.43
    altura[1] = 1.44
    altura[2] = 1.55
    altura[3] = 1.63
    altura[4] = 1.67
    altura[5] = 1.69
    altura[6] = 1.73
    altura[7] = 1.75
    altura[8] = 1.86
    altura[9] = 1.90

    nome[0] = "Alexandre"
    nome[1] = "Andre"
    nome[2] = "gustavo"

    respostas[0] = verdadeiro
    respostas[1] = verdadeiro
    respostas[2] = falso
    respostas[3] = falso

    escreva(nota[0], "\n")
    escreva(nota[1], "\n")
    escreva(nota[2], "\n")
    escreva(nota[3], "\n")

    escreva(nome[0], "\n")
    escreva(nome[1], "\n")
    escreva(nome[2], "\n")

    escreva(altura[0], "\n")
    escreva(altura[1], "\n")
    escreva(altura[2], "\n")
    escreva(altura[3], "\n")
    escreva(altura[4], "\n")
    escreva(altura[5], "\n")
    escreva(altura[6], "\n")
    escreva(altura[7], "\n")
    escreva(altura[8], "\n")
    escreva(altura[9], "\n")

    escreva(respostas[0], "\n")
    escreva(respostas[1], "\n")
    escreva(respostas[2], "\n")
    escreva(respostas[3], "\n")

    
  }
}
