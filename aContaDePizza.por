programa {
  funcao inicio() {
    //declaração de variáveis
    real valor, conta
    inteiro pessoas

  //tabela de dados
    escreva("Digite o valor da conta:")
    leia(conta)

    escreva("Quantidade de pessoas:")
    leia(pessoas)

    //processamento dos dados
    valor = conta / pessoas

    //saída de dados
    escreva("valor por pessoa: ", valor)
  }
}
