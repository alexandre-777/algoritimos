programa {
  funcao inicio() {
    inteiro tabela[2][2] //matriz 2x2 (4 elementos no total)

    //preenchendo a matriz:
    tabela[0 ] [ 0] = 10 // linha  , coluna  
    tabela[0 ] [ 1] = 20 // linha  , coluna 
    tabela[1 ] [ 0] = 30 // linha  , coluna  
    tabela[1 ] [1 ] = 40 // linha  , coluna  

    //lendo a matriz:
    escreva(tabela[0][0], "\n")
    escreva(tabela[0][1], "\n")
    escreva(tabela[1][0], "\n")
    escreva(tabela[1][1])
  }
  } 
  
